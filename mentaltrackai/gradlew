##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then to run this script, type that shell name before the whole
#       command. For example:
#
#           bash gradlew build
#
#       If you wish this script to always run under a specific POSIX-compliant
#       shell, change the first line of the script (the#! line) to the location
#       of that shell. Of course, you need to make sure that such a shell exists
#       on all the systems where this script will run.
#
#   Important for patching:
#
#   (2) This script is generated from the template file
#       tools/internal/templates/initScripts/gradle-wrapper-template.sh
#       within the Gradle project.
#
#   (3) The "control variables" (like `DEFAULT_JVM_OPTS`) are always
#       sourced from `gradle.properties` file first, then the `-D`
#       options from `GRADLE_OPTS` environment variable, then the script's
#       command-line options. The template file contains the necessary
#       logic for parsing gradle.properties and combining the options.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
# Discard cd standard output in case $CDPATH is set (https://github.com/gradle/gradle/issues/25031)
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit: $MAX_FD"
    esac
    case $MAX_FD in  #(
      '' | soft ) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit: $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * --module-path (only if needed)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variables.

# For Cygwin or MSYS, switch paths to Windows format before running java
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )
    # Now convert the arguments - kludge to limit ourselves to /bin/sh
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # don't mess with options #(
              /?*)  t=${arg#/} t=/${t%%/*}              # looks like a POSIX filepath
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --mixed "$arg" )
        fi
        # Roll the args list around exactly as many times as the number of
        # args, so each arg winds up back in the position where it started, but
        # possibly modified.
        #
        # NB: a `eval "$args"' is not used because it would wreck the
        # handling of empty strings.
        shifted_arg=$( printf '%s\n' "$arg" )
        # shellcheck disable=SC2145
        args=$( printf '%s\n' "$args" )
        args=${args:+$shifted_arg"$NL"$args}
    done
fi

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Collect all arguments for the java command:
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, JAVA_OPTS, and optsEnvironmentVar are not allowed to contain shell fragments,
#     and any embedded shellness will be escaped.
#   * For example: A user cannot expect ${Hostname} to be expanded, as it is an environment variable
#     that will be passed on to Java.

# Use "x" prefixes for the following vars to ensure they never become empty during
# prefix removal substitution.
xDEFAULT_JVM_OPTS=$( printf '%s\n' "$DEFAULT_JVM_OPTS" )
xJAVA_OPTS=$( printf '%s\n' "$JAVA_OPTS" )
xGRADLE_OPTS=$( printf '%s\n' "$GRADLE_OPTS" )

# Define the function that parses `gradle.properties`:
read_gradle_properties() {
    # Test a properties file exists and source it
    if [ -f "$1" ] && [ -r "$1" ]; then
        # shellcheck disable=SC2153
        xDEFAULT_JVM_OPTS=$( parse_error_filter "$1" "DEFAULT_JVM_OPTS" "$xDEFAULT_JVM_OPTS" )
        xJAVA_OPTS=$( parse_error_filter "$1" "JAVA_OPTS" "$xJAVA_OPTS" )
        xGRADLE_OPTS=$( parse_error_filter "$1" "GRADLE_OPTS" "$xGRADLE_OPTS" )
    fi
}

parse_error_filter() {
    # This function uses global variables:
    # - `line_var_name` (from outer scope)
    # - `property_prefix` (from outer scope)
    # - `x<defaults>` (from outer scope)
    # shellcheck disable=SC2034
    property_prefix=$2
    # shellcheck disable=SC2034
    line_var_name=$3
    sed \
        -e "s/#.*//" \
        -e "s/^[[:space:]]*//" \
        -e "s/[[:space:]]*=[[:space:]]*/=/" \
        -e "s/^[^=]*=[[:space:]]*//" \
        -e "/^$/d" \
        -e "/^$/d" \
        -e "s/.*/\"&\"/" \
        "$1" |
    while read -r line; do
        # shellcheck disable=SC2034
        line_var_name=$line
        eval $line_var_name
    done |
    sed -e "s/^/$property_prefix/" >> /tmp/gradle_properties.sh

    if [ -f /tmp/gradle_properties.sh ]; then
        # shellcheck disable=SC1091
        . /tmp/gradle_properties.sh
        rm /tmp/gradle_properties.sh
    fi
}

# Read gradle.properties from various locations
if [ -n "$GRADLE_HOME" ] && [ -d "$GRADLE_HOME" ]; then
    read_gradle_properties "$GRADLE_HOME"/gradle.properties
fi

read_gradle_properties "$APP_HOME"/gradle.properties

if [ -f /tmp/gradle_properties.sh ]; then
    # shellcheck disable=SC1091
    . /tmp/gradle_properties.sh
    rm /tmp/gradle_properties.sh
fi

# Override default JVM options if properties are defined
if [ -n "$gradle_default_jvm_opts" ] ; then
    xDEFAULT_JVM_OPTS=$( printf '%s\n' "$gradle_default_jvm_opts" )
fi

if [ -n "$gradle_java_opts" ] ; then
    xJAVA_OPTS=$( printf '%s\n' "$gradle_java_opts" )
fi

if [ -n "$gradle_opts" ] ; then
    xGRADLE_OPTS=$( printf '%s\n' "$gradle_opts" )
fi

# Escape shell characters for arguments
# shellcheck disable=SC2086
xDEFAULT_JVM_OPTS=$( printf '%s\n' "$xDEFAULT_JVM_OPTS" | xargs printf '%s ' | sed -e 's/\([][\"\$\\]\)/\\\1/g' )
# shellcheck disable=SC2086
xJAVA_OPTS=$( printf '%s\n' "$xJAVA_OPTS" | xargs printf '%s ' | sed -e 's/\([][\"\$\\]\)/\\\1/g' )
# shellcheck disable=SC2086
xGRADLE_OPTS=$( printf '%s\n' "$xGRADLE_OPTS" | xargs printf '%s ' | sed -e 's/\([][\"\$\\]\)/\\\1/g' )

# Assemble the command
CMD=( "$JAVACMD" )
# shellcheck disable=SC2206
DEFAULT_JVM_OPTS=$( printf '%s\n' "$xDEFAULT_JVM_OPTS" )
for jvm_opt in $DEFAULT_JVM_OPTS; do
    # shellcheck disable=SC2206
    CMD+=( $jvm_opt )
done
# shellcheck disable=SC2206
JAVA_OPTS=$( printf '%s\n' "$xJAVA_OPTS" )
for jvm_opt in $JAVA_OPTS; do
    # shellcheck disable=SC2206
    CMD+=( $jvm_opt )
done
# shellcheck disable=SC2206
GRADLE_OPTS=$( printf '%s\n' "$xGRADLE_OPTS" )
for jvm_opt in $GRADLE_OPTS; do
    # shellcheck disable=SC2206
    CMD+=( $jvm_opt )
done

CMD+=( -classpath "$CLASSPATH" )
CMD+=( org.gradle.wrapper.GradleWrapperMain )
# And finally, add the user-provided arguments:
CMD+=( "$@" )

exec "${CMD[@]}"